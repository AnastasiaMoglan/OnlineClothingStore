@{
    ViewData["Title"] = "Cos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cart = ViewBag.Cart;
}

<section class="shop-hero">
    <div>
        <span class="hero-kicker">Shopping Cart</span>
        <h1>Cosul meu</h1>
        <p>Verifica produsele alese si continua spre checkout.</p>
    </div>

    <div class="hero-actions">
        <a href="/Store/Catalog" class="btn secondary">Continua cumparaturile</a>
        <a asp-controller="Store" asp-action="Memento" class="btn primary">Outfit Designer</a>
    </div>
</section>

@if (cart.Count == 0)
{
    <section class="empty-state">
        <h2>Cosul este gol</h2>
        <p>Adauga produse din catalog pentru a continua comanda.</p>
        <div class="summary-actions">
            <a href="/Store/Catalog" class="btn primary">Mergi la catalog</a>
            <a asp-controller="Store" asp-action="Memento" class="btn secondary">Creeaza tinuta</a>
        </div>
    </section>
}
else
{
    <section class="cart-list">
        @foreach (var item in cart)
        {
            <div class="cart-line">
                <div class="cart-product">
                    <div class="cart-img">
                        @item.Product.Category
                    </div>

                    <div>
                        <h3>@item.Product.Name</h3>
                        <p>@item.Product.Category | @item.Product.Color | Marime @item.Product.Size</p>
                        <strong>@item.Product.Price MDL</strong>
                    </div>
                </div>

                <div class="quantity-actions">
                    <a href="/Store/DecreaseQuantity/@item.Product.Id">-</a>
                    <span>@item.Quantity</span>
                    <a href="/Store/IncreaseQuantity/@item.Product.Id">+</a>
                </div>

                <div class="line-total">
                    @(item.Product.Price * item.Quantity) MDL
                </div>

                <a href="/Store/RemoveFromCart/@item.Product.Id" class="remove-link">Sterge</a>
            </div>
        }
    </section>

    <section class="cart-summary">
        <h2>Total: @ViewBag.Total MDL</h2>

        <div class="summary-actions">
            <a href="/Store/ClearCart" class="btn secondary">Goleste cosul</a>
            <a asp-controller="Store" asp-action="Memento" class="btn secondary">Creeaza tinuta</a>
            <a href="/Store/Checkout" class="btn primary">Checkout</a>
        </div>
    </section>
}
