@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var channels = ViewBag.NotificationChannels;
}

<section class="page-header">
    <h1>Checkout</h1>
    <p>Confirmă comanda și alege metodele de notificare.</p>
</section>

<section class="checkout-layout">
    <div class="checkout-card">
        <h2>Comanda ta</h2>
        <p>Total de plată: <b>@ViewBag.Total MDL</b></p>

        <h3>Metode notificare</h3>

        <div class="checkout-actions">
            <a href="/Store/Checkout?email=true&sms=false&push=false">Email</a>
            <a href="/Store/Checkout?email=true&sms=true&push=false">Email + SMS</a>
            <a href="/Store/Checkout?email=true&sms=true&push=true">Email + SMS + Push</a>
        </div>
    </div>

    <div class="checkout-card success">
        <h2>Comandă confirmată</h2>

        <p>Notificări trimise prin:</p>

        <ul>
            @foreach (var channel in channels)
            {
                <li>@channel</li>
            }
        </ul>

        <p class="pattern-note">@ViewBag.DecoratorInfo</p>
    </div>
</section>