@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cart = ViewBag.Cart;

    bool wasCalculated = ViewBag.WasCalculated == true;

    string orderType = ViewBag.OrderType as string ?? "standard";
    string deliveryMethod = ViewBag.DeliveryMethod as string ?? "courier";
    string discountType = ViewBag.DiscountType as string ?? "none";
    string packagingType = ViewBag.PackagingType as string ?? "standard";

    decimal productsTotal = ViewBag.ProductsTotal ?? 0;
    decimal servicePrice = ViewBag.ServicePrice ?? 0;
    decimal deliveryPrice = ViewBag.DeliveryPrice ?? 0;
    decimal packagingPrice = ViewBag.PackagingPrice ?? 0;
    decimal discountValue = ViewBag.DiscountValue ?? 0;
    decimal totalAfterDiscount = ViewBag.TotalAfterDiscount ?? productsTotal;
    decimal finalTotal = ViewBag.FinalTotal ?? totalAfterDiscount + packagingPrice;
}

<section class="shop-hero">
    <div>
        <span class="hero-kicker">Checkout</span>
        <h1>Finalizare comanda</h1>
        <p>
            Verifica produsele, alege livrarea, ambalajul si reducerea. Totalul se actualizeaza
            cu toate costurile selectate.
        </p>
    </div>

    <a asp-controller="Store" asp-action="Cart" class="btn secondary">Inapoi la cos</a>
</section>

@if (cart.Count == 0)
{
    <section class="empty-state">
        <h2>Cosul este gol</h2>
        <p>Adauga produse din catalog inainte de checkout.</p>
        <a asp-controller="Store" asp-action="Catalog" class="btn primary">Mergi la catalog</a>
    </section>
}
else
{
    <section class="checkout-products">
        <h2>Produsele alese</h2>

        <div class="checkout-product-list">
            @foreach (var item in cart)
            {
                <div class="checkout-product-line">
                    <div>
                        <strong>@item.Product.Name</strong>
                        <span>@item.Product.Category | @item.Product.Color | Marime @item.Product.Size</span>
                    </div>

                    <b>@item.Quantity x @item.Product.Price MDL</b>
                </div>
            }
        </div>
    </section>

    <section class="bridge-page checkout-delivery">
        <div class="bridge-layout">

            <form asp-controller="Store" asp-action="Checkout" method="post" class="bridge-form">
                <h2>Detalii comanda</h2>

                <p class="bridge-small-info">
                    Completeaza datele de livrare si alege ambalajul potrivit pentru comanda ta.
                </p>

                <div class="form-group">
                    <label>Nume client</label>
                    <input type="text" name="customerName" value="@ViewBag.CustomerName" />
                </div>

                <div class="form-group">
                    <label>Adresa / locatie livrare</label>
                    <input type="text" name="address" value="@ViewBag.Address" />
                </div>

                <div class="bridge-options-grid">
                    <div class="bridge-option-box">
                        <h3>Tipul comenzii</h3>

                        <label class="bridge-radio-item">
                            <input type="radio" name="orderType" value="standard" @(orderType == "standard" ? "checked" : "") />
                            <span>
                                <strong>Comanda standard</strong>
                                <small>Fara cost suplimentar</small>
                            </span>
                        </label>

                        <label class="bridge-radio-item">
                            <input type="radio" name="orderType" value="express" @(orderType == "express" ? "checked" : "") />
                            <span>
                                <strong>Comanda expres</strong>
                                <small>Procesare rapida: +80 MDL</small>
                            </span>
                        </label>

                        <label class="bridge-radio-item">
                            <input type="radio" name="orderType" value="gift" @(orderType == "gift" ? "checked" : "") />
                            <span>
                                <strong>Comanda cadou</strong>
                                <small>Pregatire speciala: +120 MDL</small>
                            </span>
                        </label>
                    </div>

                    <div class="bridge-option-box">
                        <h3>Metoda de livrare</h3>

                        <label class="bridge-radio-item">
                            <input type="radio" name="deliveryMethod" value="courier" @(deliveryMethod == "courier" ? "checked" : "") />
                            <span>
                                <strong>Curier</strong>
                                <small>Livrare la adresa: +70 MDL</small>
                            </span>
                        </label>

                        <label class="bridge-radio-item">
                            <input type="radio" name="deliveryMethod" value="pickup" @(deliveryMethod == "pickup" ? "checked" : "") />
                            <span>
                                <strong>Ridicare din magazin</strong>
                                <small>Fara cost suplimentar</small>
                            </span>
                        </label>

                        <label class="bridge-radio-item">
                            <input type="radio" name="deliveryMethod" value="locker" @(deliveryMethod == "locker" ? "checked" : "") />
                            <span>
                                <strong>Locker</strong>
                                <small>Livrare la locker: +45 MDL</small>
                            </span>
                        </label>
                    </div>
                </div>

                <div class="packaging-option-box">
                    <div class="packaging-heading">
                        <div>
                            <h3>Alege ambalajul</h3>
                            <p>Ambalajul este adaugat separat in totalul comenzii.</p>
                        </div>
                    </div>

                    <label class="packaging-radio-item @(packagingType == "standard" ? "active" : "")">
                        <input type="radio" name="packagingType" value="standard" @(packagingType == "standard" ? "checked" : "") />
                        <img class="packaging-option-image"
                             src="https://www.top-packaging.com/uploadfile/201908/12/61cc3bf8fc5f8a029e9d37fc90cb14ed_medium.jpg"
                             alt="Cutie kraft pentru ambalare standard" />
                        <span>
                            <strong>Ambalare standard</strong>
                            <small>Cutie simpla din carton kraft, eticheta standard si sumarul comenzii.</small>
                        </span>
                        <b>Gratuit</b>
                    </label>

                    <label class="packaging-radio-item @(packagingType == "eco" ? "active" : "")">
                        <input type="radio" name="packagingType" value="eco" @(packagingType == "eco" ? "checked" : "") />
                        <img class="packaging-option-image"
                             src="https://forestpackage.com/wp-content/uploads/2023/02/apparel-box.jpg"
                             alt="Ambalaj eco pentru haine" />
                        <span>
                            <strong>Eco Smart Pack</strong>
                            <small>Cutie reciclata, eticheta eco si card de multumire.</small>
                        </span>
                        <b>+45 MDL</b>
                    </label>

                    <label class="packaging-radio-item luxury @(packagingType == "luxury" ? "active" : "")">
                        <input type="radio" name="packagingType" value="luxury" @(packagingType == "luxury" ? "checked" : "") />
                        <img class="packaging-option-image"
                             src="https://image.made-in-china.com/2f0j00zLqoaWkGvUcb/Custom-Logo-Printed-Purple-Premium-Schmuck-Box-Jewelry-Packaging-Pouch-and-Boxes-Slide-Drawer-Jewelry-Box-Packaging.jpg"
                             alt="Ambalaj luxury premium" />
                        <span>
                            <strong>Luxury Gift Wrap</strong>
                            <small>Cutie premium, eticheta aurie si card cu instructiuni de ingrijire.</small>
                        </span>
                        <b>+120 MDL</b>
                    </label>
                </div>

                <div class="strategy-option-box">
                    <h3>Alege reducerea</h3>

                    <label class="strategy-radio-item">
                        <input type="radio" name="discountType" value="none" @(discountType == "none" ? "checked" : "") />
                        <span>
                            <strong>Fara reducere</strong>
                            <small>Comanda se calculeaza fara reducere.</small>
                        </span>
                    </label>

                    <label class="strategy-radio-item">
                        <input type="radio" name="discountType" value="newCustomer" @(discountType == "newCustomer" ? "checked" : "") />
                        <span>
                            <strong>Client nou</strong>
                            <small>Reducere de 5% pentru prima comanda.</small>
                        </span>
                    </label>

                    <label class="strategy-radio-item">
                        <input type="radio" name="discountType" value="student" @(discountType == "student" ? "checked" : "") />
                        <span>
                            <strong>Student</strong>
                            <small>Reducere de 10% pentru studenti.</small>
                        </span>
                    </label>

                    <label class="strategy-radio-item">
                        <input type="radio" name="discountType" value="vip" @(discountType == "vip" ? "checked" : "") />
                        <span>
                            <strong>VIP</strong>
                            <small>Reducere de 15% pentru clientii VIP.</small>
                        </span>
                    </label>
                </div>

                <button type="submit" class="bridge-btn">
                    Calculeaza si confirma comanda
                </button>
            </form>

            <div class="bridge-result">
                <h2>Rezumat comanda</h2>

                <div class="bridge-summary">
                    <div>
                        <span>Total produse</span>
                        <strong>@productsTotal MDL</strong>
                    </div>

                    <div>
                        <span>Reducere aplicata</span>
                        <strong>-@discountValue MDL</strong>
                    </div>

                    <div>
                        <span>Total dupa reducere</span>
                        <strong>@totalAfterDiscount MDL</strong>
                    </div>

                    <div>
                        <span>Cost serviciu</span>
                        <strong>@servicePrice MDL</strong>
                    </div>

                    <div>
                        <span>Cost livrare</span>
                        <strong>@deliveryPrice MDL</strong>
                    </div>

                    <div>
                        <span>Ambalaj</span>
                        <strong>@packagingPrice MDL</strong>
                    </div>

                    <div class="bridge-total">
                        <span>Total final</span>
                        <strong>@finalTotal MDL</strong>
                    </div>
                </div>

                <div class="packaging-result-box">
                    <img class="packaging-result-image"
                         src="@ViewBag.PackagingImageUrl"
                         alt="Ambalaj selectat" />

                    <div class="packaging-result-header">
                        <span>Ambalaj ales</span>
                        <strong>@ViewBag.PackagingName</strong>
                    </div>

                    <div class="packaging-details-grid">
                        <div>
                            <span>Cutie</span>
                            <p>@ViewBag.PackagingBoxDescription</p>
                        </div>

                        <div>
                            <span>Eticheta</span>
                            <p>@ViewBag.PackagingLabelDescription</p>
                        </div>

                        <div>
                            <span>Insert</span>
                            <p>@ViewBag.PackagingInsertDescription</p>
                        </div>
                    </div>
                </div>

                <div class="strategy-result-box">
                    <h3>Reducere</h3>

                    <div class="checkout-summary-row">
                        <span>Optiune selectata</span>
                        <strong>@ViewBag.DiscountName</strong>
                    </div>

                    <div class="checkout-summary-row">
                        <span>Descriere</span>
                        <strong>@ViewBag.DiscountDescription</strong>
                    </div>

                    <div class="checkout-summary-row">
                        <span>Valoare reducere</span>
                        <strong>-@discountValue MDL</strong>
                    </div>
                </div>

                @if (wasCalculated)
                {
                    <div class="success-box">
                        Comanda a fost configurata cu succes.
                    </div>

                    <div class="bridge-message-box">
                        <h3>Tip comanda</h3>
                        <p>@ViewBag.OrderTypeName</p>
                    </div>

                    <div class="bridge-message-box">
                        <h3>Metoda livrare</h3>
                        <p>@ViewBag.DeliveryMethodName</p>
                    </div>

                    <div class="bridge-message-box">
                        <h3>Pregatire comanda</h3>
                        <p>@ViewBag.PreparationResult</p>
                    </div>

                    <div class="bridge-message-box">
                        <h3>Livrare</h3>
                        <p>@ViewBag.DeliveryResult</p>
                    </div>
                }
                else
                {
                    <p class="empty-result">
                        Alege optiunile pentru livrare, ambalaj si reducere, apoi apasa pe buton pentru totalul final.
                    </p>
                }
            </div>
        </div>
    </section>
}
