@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="shop-hero">
    <div>
        <span class="hero-kicker">Checkout</span>
        <h1>Finalizare comanda</h1>
        <p>Pagina simpla pentru finalizarea comenzii.</p>
    </div>

    <a href="/Store/Cart" class="btn secondary">Inapoi la cos</a>
</section>

<section class="checkout-layout">
    <div class="checkout-card">
        <h2>Rezumat comanda</h2>
        <p>Total: <b>@ViewBag.Total MDL</b></p>
        <p>Comanda poate fi procesata dupa confirmare.</p>
    </div>

    <div class="checkout-card success">
        <h2>Confirmare</h2>
        <p>Comanda a fost pregatita pentru procesare.</p>
        <a href="/Store/Catalog" class="btn primary">Inapoi la catalog</a>
    </div>
</section>