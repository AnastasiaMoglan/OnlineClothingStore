@{
    ViewData["Title"] = "Catalog";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var products = ViewBag.Products;
    var categories = ViewBag.Categories;
}

<section class="page-header">
    <h1>Catalog produse</h1>
    <p>Alege hainele preferate și adaugă-le în coș.</p>
</section>

<section class="filters">
    <a href="/Store/Catalog">Toate</a>

    @foreach (var category in categories)
    {
        <a href="/Store/Catalog?category=@category">@category</a>
    }
</section>

<section class="product-grid">
    @foreach (var product in products)
    {
        <div class="product-card">
            <div class="product-img">@product.Category</div>

            <h3>@product.Name</h3>
            <p>Culoare: @product.Color</p>
            <p>Mărime: @product.Size</p>
            <strong>@product.Price MDL</strong>

            <div class="card-actions">
                <a href="/Store/Product/@product.Id">Detalii</a>
                <a href="/Store/AddToCart/@product.Id">Adaugă în coș</a>
            </div>
        </div>
    }
</section>

<div class="pattern-box">
    <b>Optimizare catalog:</b>
    <p>@ViewBag.FlyweightInfo</p>
</div>