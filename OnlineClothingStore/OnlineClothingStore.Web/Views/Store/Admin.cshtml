@using OnlineClothingStore.App.Structural.Observer
@using OnlineClothingStore.Web.Controllers
@using OnlineClothingStore.Web.Models

@{
    ViewData["Title"] = "Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var categoryStyles = ViewBag.CategoryStyles;
    var products = ViewBag.Products;

    List<IStockObserver> observers =
        ViewBag.Observers as List<IStockObserver> ?? new List<IStockObserver>();

    List<StockNotification> notifications =
        ViewBag.StockNotifications as List<StockNotification> ?? new List<StockNotification>();

    IReadOnlyList<StoreController.IAdminCommand> commandHistory =
        ViewBag.CommandHistory as IReadOnlyList<StoreController.IAdminCommand>
        ?? new List<StoreController.IAdminCommand>();

    string commandLastMessage =
        ViewBag.CommandLastMessage as string ?? "Nu a fost executata nicio comanda.";

    List<ReturnRequestRecord> returnRequests =
        ViewBag.ReturnRequests as List<ReturnRequestRecord> ?? new List<ReturnRequestRecord>();
}

<section class="shop-hero">
    <div>
        <span class="hero-kicker">Admin Panel</span>
        <h1>Administrare magazin</h1>
        <p>
            Aici adminul gestioneaza stilurile, stocurile, comenzile administrative
            si abonarea clientilor la modificarile de stoc.
        </p>
    </div>

    <div class="hero-actions">
        <a href="/Store/Catalog" class="btn primary">Inapoi la catalog</a>
        <a href="/Store/Logout" class="btn secondary">Logout</a>
    </div>
</section>

<section class="admin-panel">
    <div class="admin-card">
        <h2>Utilizator curent</h2>
        <p>Rol: <b>@ViewBag.Role</b></p>

        <div class="checkout-actions">
            <a href="/Store/Login?role=Customer">Intra ca Customer</a>
            <a href="/Store/Login?role=Cashier">Intra ca Cashier</a>
            <a href="/Store/Login?role=Manager">Intra ca Manager</a>
        </div>
    </div>

    <div class="admin-card">
        <h2>Flyweight in Admin</h2>
        <p class="pattern-note">@ViewBag.FlyweightAdminInfo</p>
        <p>
            Modifica o culoare la categoria <b>T-Shirts</b>, salveaza, apoi verifica in catalog:
            toate tricourile vor avea acelasi stil modificat.
        </p>
    </div>
</section>

<section class="admin-command-shortcut">
    <div>
        <span class="section-kicker">Command Pattern</span>
        <h2>Comenzi administrative</h2>
        <p>
            Modificarile de stoc si pret pot fi executate ca obiecte Command.
            Fiecare actiune este salvata in istoric si poate fi anulata prin Undo.
        </p>

        <p class="pattern-note">
            Ultima actiune: @commandLastMessage
        </p>
    </div>

    <div class="admin-command-actions">
        <a asp-controller="Store" asp-action="AdminCommands" class="btn primary">
            Deschide comenzi admin
        </a>

        <form asp-controller="Store" asp-action="UndoLastAdminCommand" method="post">
            <button type="submit" class="btn secondary">
                Undo ultima comanda
            </button>
        </form>
    </div>
</section>

@if (commandHistory.Count > 0)
{
    <section class="admin-command-history">
        <div class="admin-stock-header">
            <div>
                <span class="section-kicker">Istoric Command</span>
                <h2>Ultimele comenzi executate</h2>
                <p>
                    Aceste actiuni au fost executate prin sablonul Command si pot fi anulate in ordine inversa.
                </p>
            </div>
        </div>

        <div class="command-history-list">
            @foreach (StoreController.IAdminCommand command in commandHistory)
            {
                <div class="command-history-item">
                    <strong>@command.Name</strong>
                    <p>@command.Description</p>
                </div>
            }
        </div>
    </section>
}

<section class="admin-returns-section">
    <div class="admin-stock-header">
        <div>
            <span class="section-kicker">Retururi clienti</span>
            <h2>Cereri de retur primite</h2>
            <p>
                Cererile trimise de clienti sunt salvate aici ca magazinul sa le poata verifica
                si prelua pentru procesare.
            </p>
        </div>

        <a asp-controller="Store" asp-action="Returns" class="btn secondary">
            Formular retur
        </a>
    </div>

    @if (returnRequests.Count == 0)
    {
        <p class="empty-result">Nu exista cereri de retur inregistrate.</p>
    }
    else
    {
        <div class="admin-returns-table">
            <table>
                <thead>
                    <tr>
                        <th>Cerere</th>
                        <th>Client</th>
                        <th>Comanda</th>
                        <th>Motiv</th>
                        <th>Status</th>
                        <th>Actiune</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (ReturnRequestRecord request in returnRequests)
                    {
                        <tr>
                            <td>
                                <strong>#@request.Id</strong>
                                <span>@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </td>

                            <td>
                                <strong>@request.CustomerEmail</strong>
                                <span>@request.PhoneNumber</span>
                            </td>

                            <td>
                                <strong>@request.OrderNumber</strong>
                                <span>@request.ProductName</span>
                            </td>

                            <td>
                                <strong>@request.ReturnType</strong>
                                <span>@request.ReturnReason</span>
                            </td>

                            <td>
                                <span class="return-status @(request.Status == "Inregistrat" ? "registered" : "new")">
                                    @request.Status
                                </span>

                                @if (request.RegisteredAt.HasValue)
                                {
                                    <small>@request.RegisteredAt.Value.ToString("dd.MM.yyyy HH:mm")</small>
                                }
                            </td>

                            <td>
                                @if (request.Status == "Inregistrat")
                                {
                                    <span class="return-done">Preluat</span>
                                }
                                else
                                {
                                    <form asp-controller="Store" asp-action="RegisterReturnRequest" method="post">
                                        <input type="hidden" name="id" value="@request.Id" />
                                        <button type="submit" class="return-register-btn">
                                            Inregistreaza
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="admin-stock-section">
    <div class="admin-stock-header">
        <div>
            <span class="section-kicker">Stocuri</span>
            <h2>Administrare stoc produse</h2>
            <p>
                Stocurile sunt vizibile si modificabile doar din Admin.
                Pentru demonstrarea completa a sablonului Command, foloseste pagina
                <b>Comenzi admin</b>, unde modificarile pot fi anulate prin Undo.
            </p>
        </div>
    </div>

    <div class="admin-stock-table">
        <table>
            <thead>
                <tr>
                    <th>Produs</th>
                    <th>Categorie</th>
                    <th>Marime</th>
                    <th>Pret</th>
                    <th>Stoc</th>
                    <th>Actiune</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var product in products)
                {
                    <tr>
                        <td>
                            <strong>@product.Name</strong>
                            <span>@product.Color</span>
                        </td>

                        <td>@product.Category</td>
                        <td>@product.Size</td>
                        <td>@product.Price MDL</td>

                        <td>
                            <form asp-controller="Store"
                                  asp-action="UpdateProductStock"
                                  method="post"
                                  class="stock-edit-form">
                                <input type="hidden" name="id" value="@product.Id" />

                                <input type="number"
                                       name="stockQuantity"
                                       min="0"
                                       value="@product.StockQuantity" />

                                <button type="submit">Salveaza</button>
                            </form>
                        </td>

                        <td>
                            @if (product.StockQuantity == 0)
                            {
                                <span class="stock-badge danger">Epuizat</span>
                            }
                            else if (product.StockQuantity <= 5)
                            {
                                <span class="stock-badge warning">Stoc mic</span>
                            }
                            else
                            {
                                <span class="stock-badge ok">Disponibil</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="admin-observer-section">
    <div class="observer-card">
        <h2>Abonari active</h2>

        <p class="observer-info">
            Aceste abonari sunt vizibile doar pentru Admin.
            Cand stocul unui produs este modificat, clientii abonati la acel produs sunt notificati automat.
        </p>

        @if (observers.Count == 0)
        {
            <p class="empty-result">Nu exista inca abonati la modificarile de stoc.</p>
        }
        else
        {
            <div class="observer-list">
                @foreach (IStockObserver observer in observers)
                {
                    <div class="observer-item">
                        <div>
                            <strong>@observer.CustomerName</strong>
                            <span>@observer.Email</span>
                            <small>ID produs urmarit: @observer.ProductId</small>
                        </div>

                        <form asp-controller="Store" asp-action="UnsubscribeStockAlert" method="post">
                            <input type="hidden" name="productId" value="@observer.ProductId" />
                            <input type="hidden" name="email" value="@observer.Email" />

                            <button type="submit" class="observer-remove-btn">
                                Dezaboneaza
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>

    <div class="observer-card">
        <div class="observer-title-row">
            <h2>Notificari generate</h2>

            <a asp-controller="Store" asp-action="ClearStockNotifications" class="observer-clear-btn">
                Sterge notificarile
            </a>
        </div>

        @if (notifications.Count == 0)
        {
            <p class="empty-result">Nu exista notificari generate.</p>
        }
        else
        {
            <div class="observer-notifications">
                @foreach (StockNotification notification in notifications)
                {
                    <div class="observer-notification">
                        <strong>@notification.CustomerName</strong>
                        <span>@notification.Email</span>
                        <p>@notification.Message</p>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="style-editor-grid">
    @foreach (var style in categoryStyles)
    {
        <form method="post"
              action="/Store/UpdateCategoryStyle"
              class="style-editor-card"
              style="background:@style.BackgroundColor; font-family:@style.FontFamily">

            <h3>@style.Category</h3>

            <input type="hidden" name="Category" value="@style.Category" />

            <label>Culoare badge</label>
            <input type="color" name="BadgeColor" value="@style.BadgeColor" />

            <label>Culoare text badge</label>
            <input type="color" name="TextColor" value="@style.TextColor" />

            <label>Font card</label>
            <select name="FontFamily">
                <option value="Arial" selected="@(style.FontFamily == "Arial")">Arial</option>
                <option value="Poppins" selected="@(style.FontFamily == "Poppins")">Poppins</option>
                <option value="Roboto" selected="@(style.FontFamily == "Roboto")">Roboto</option>
                <option value="Montserrat" selected="@(style.FontFamily == "Montserrat")">Montserrat</option>
                <option value="Georgia" selected="@(style.FontFamily == "Georgia")">Georgia</option>
            </select>

            <label>Culoare fundal card</label>
            <input type="color" name="BackgroundColor" value="@style.BackgroundColor" />

            <button type="submit">Salveaza stilul</button>
        </form>
    }
</section>
