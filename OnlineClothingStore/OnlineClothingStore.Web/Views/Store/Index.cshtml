﻿@{
    ViewData["Title"] = "BlueWear";
}

<section class="home-page">
    <div class="home-content">

        <div class="home-logo">
            <span>BW</span>
        </div>

        <p class="home-subtitle">BlueWear Online Store</p>

        <h1>Stilul tău începe aici</h1>

        <p class="home-text">
            Descoperă haine moderne, comode și ușor de combinat pentru fiecare zi.
        </p>

        <div class="home-buttons">
            <a asp-controller="Store" asp-action="Catalog" class="home-btn-primary">
                Vezi catalogul
            </a>

            <a asp-controller="Store" asp-action="Wishlist" class="home-btn-secondary">
                Wishlist
            </a>
        </div>

        <div class="home-cards">
            <div class="home-card">
                <h3>Casual</h3>
                <p>Ținute pentru fiecare zi</p>
            </div>

            <div class="home-card">
                <h3>Modern</h3>
                <p>Stil actual și curat</p>
            </div>

            <div class="home-card">
                <h3>Rapid</h3>
                <p>Adaugi simplu în coș</p>
            </div>
        </div>

    </div>
</section>