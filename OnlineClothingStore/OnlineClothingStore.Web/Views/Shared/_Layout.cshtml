<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BlueWear</title>

    <link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
</head>
<body>

<header class="topbar">
    <div class="logo">
        <a href="/Store/Index">BlueWear</a>
    </div>

    <nav>
        <a href="/Store/Index">Home</a>
        <a href="/Store/Catalog">Catalog</a>
        <a href="/Store/Wishlist">Wishlist (@(ViewBag.WishlistCount ?? 0))</a>
        <a href="/Store/Cart">Cos (@(ViewBag.CartCount ?? 0))</a>
        <a href="/Store/AdminLogin">Admin Login</a>
    </nav>

    <div class="auth">
        <a href="/Store/AdminLogin" class="manager">Admin</a>
        <a href="/Store/Logout">Logout</a>
    </div>
</header>

<main>
    @RenderBody()
</main>

<footer>
    <p>© 2026 BlueWear Online Clothing Store | TMPPP / OOP</p>
    <p class="footer-note">Structural pattern demonstrat: Flyweight</p>
</footer>

</body>
</html>