<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BlueWear</title>

    <link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
</head>
<body>

<header class="topbar">
    <div class="logo">
        <a asp-controller="Store" asp-action="Index">BlueWear</a>
    </div>

    <nav>
        <a asp-controller="Store" asp-action="Index">Home</a>
        <a asp-controller="Store" asp-action="Catalog">Catalog</a>
        <a asp-controller="Store" asp-action="Memento">Outfit Designer</a>
        <a asp-controller="Store" asp-action="Decorator">Notificări</a>
        <a asp-controller="Store" asp-action="StockAlerts">Abonări stoc</a>
        <a asp-controller="Store" asp-action="AdminCommands">Comenzi admin</a>
        <a asp-controller="Store" asp-action="Wishlist">Wishlist (@(ViewBag.WishlistCount ?? 0))</a>
        <a asp-controller="Store" asp-action="Cart">Coș (@(ViewBag.CartCount ?? 0))</a>
        <a asp-controller="Store" asp-action="AdminLogin">Admin Login</a>
    </nav>

    <div class="auth">
        <a class="manager" asp-controller="Store" asp-action="Admin">Admin</a>
        <a asp-controller="Store" asp-action="Logout">Logout</a>
    </div>
</header>

<main>
    @RenderBody()
</main>

<footer>
    <p>© 2026 BlueWear Online Clothing Store | TMPPP / OOP</p>
    <p class="footer-note">BlueWear Online Clothing Store</p>
</footer>

</body>
</html>