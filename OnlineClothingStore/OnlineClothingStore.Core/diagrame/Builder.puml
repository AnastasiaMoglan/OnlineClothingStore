@startuml
title Builder - Customer Support Request

skinparam classAttributeIconSize 0

class CustomerSupportRequest {
    +OrderNumber : string
    +CustomerEmail : string
    +ProblemType : string
    +Description : string
    +PreferredSolution : string
    +IsUrgent : bool
    +AttachedImages : IReadOnlyList<string>
}

interface ICustomerSupportRequestBuilder {
    +Reset() : ICustomerSupportRequestBuilder
    +SetBasicInfo(orderNumber : string, email : string) : ICustomerSupportRequestBuilder
    +SetProblem(problemType : string, description : string) : ICustomerSupportRequestBuilder
    +SetPreferredSolution(solution : string) : ICustomerSupportRequestBuilder
    +MarkAsUrgent() : ICustomerSupportRequestBuilder
    +AddAttachedImage(imageName : string) : ICustomerSupportRequestBuilder
    +Build() : CustomerSupportRequest
}

class CustomerSupportRequestBuilder {
    +Reset() : ICustomerSupportRequestBuilder
    +SetBasicInfo(orderNumber : string, email : string) : ICustomerSupportRequestBuilder
    +SetProblem(problemType : string, description : string) : ICustomerSupportRequestBuilder
    +SetPreferredSolution(solution : string) : ICustomerSupportRequestBuilder
    +MarkAsUrgent() : ICustomerSupportRequestBuilder
    +AddAttachedImage(imageName : string) : ICustomerSupportRequestBuilder
    +Build() : CustomerSupportRequest
}

class SupportRequestDirector {
    +BuildDamagedProductComplaint(orderNumber : string, email : string) : CustomerSupportRequest
    +BuildWrongSizeComplaint(orderNumber : string, email : string) : CustomerSupportRequest
    +BuildDeliveryDelayComplaint(orderNumber : string, email : string) : CustomerSupportRequest
}

ICustomerSupportRequestBuilder <|.. CustomerSupportRequestBuilder

SupportRequestDirector --> ICustomerSupportRequestBuilder : uses
CustomerSupportRequestBuilder ..> CustomerSupportRequest : builds
SupportRequestDirector ..> CustomerSupportRequest : returns

@enduml