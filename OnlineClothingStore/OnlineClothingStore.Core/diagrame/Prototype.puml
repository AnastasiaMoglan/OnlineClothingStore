@startuml
title Prototype - Size Guide Templates

skinparam classAttributeIconSize 0

class SizeGuide {
    +Category : string
    +BrandName : string
    +Region : string
    +Sizes : List<string>
    +Measurements : Dictionary<string, string>
    +Notes : string
}

interface ISizeGuidePrototype {
    +Clone() : SizeGuide
}

class SizeGuidePrototype {
    -_sizeGuide : SizeGuide
    +Clone() : SizeGuide
}

class SizeGuideRegistry {
    -_templates : Dictionary<string, ISizeGuidePrototype>
    +Register(key : string, prototype : ISizeGuidePrototype) : void
    +GetClone(key : string) : SizeGuide
}

ISizeGuidePrototype <|.. SizeGuidePrototype

SizeGuidePrototype --> SizeGuide : stores template
SizeGuidePrototype ..> SizeGuide : creates deep clone

SizeGuideRegistry --> ISizeGuidePrototype : stores prototypes
SizeGuideRegistry ..> SizeGuide : returns clone

@enduml