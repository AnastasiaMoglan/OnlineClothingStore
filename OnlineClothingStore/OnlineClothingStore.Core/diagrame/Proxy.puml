@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
    BackgroundColor #F8FBFF
    BorderColor #1F5F99
    ArrowColor #1F5F99
}

title Proxy Pattern - BlueWear Inventory Access Control

class InventoryReportItem {
    + ProductName : string
    + Category : string
    + SellingPrice : decimal
    + StockQuantity : int
    + SupplierName : string
    + PurchasePrice : decimal
    + EstimatedProfit : decimal
    + IsSensitiveDataVisible : bool
}

interface IInventoryReport {
    + GetReport(userRole : string) : List<InventoryReportItem>
    + GetAccessMessage(userRole : string) : string
}

class RealInventoryReport {
    - items : List<InventoryReportItem>
    + GetReport(userRole : string) : List<InventoryReportItem>
    + GetAccessMessage(userRole : string) : string
}

class InventoryReportProxy {
    - realInventoryReport : RealInventoryReport
    + GetReport(userRole : string) : List<InventoryReportItem>
    + GetAccessMessage(userRole : string) : string
}

class StoreController {
    + Inventory() : IActionResult
}

IInventoryReport <|.. RealInventoryReport
IInventoryReport <|.. InventoryReportProxy

InventoryReportProxy o-- RealInventoryReport : controls access to

RealInventoryReport --> InventoryReportItem : creates full report
InventoryReportProxy --> InventoryReportItem : returns filtered report

StoreController ..> IInventoryReport : uses
StoreController ..> InventoryReportProxy : creates proxy

@enduml