@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
    BackgroundColor #F8FBFF
    BorderColor #1F5F99
    ArrowColor #1F5F99
}

title Bridge Pattern - BlueWear Delivery System

interface IDeliveryMethod {
    + Name : string
    + DeliveryPrice : decimal
    + Deliver(customerName : string, address : string) : string
}

class CourierDeliveryMethod {
    + Name : string
    + DeliveryPrice : decimal
    + Deliver(customerName : string, address : string) : string
}

class PickupDeliveryMethod {
    + Name : string
    + DeliveryPrice : decimal
    + Deliver(customerName : string, address : string) : string
}

class LockerDeliveryMethod {
    + Name : string
    + DeliveryPrice : decimal
    + Deliver(customerName : string, address : string) : string
}

abstract class DeliveryOrder {
    - deliveryMethod : IDeliveryMethod
    + OrderType : string
    + ServicePrice : decimal
    + PrepareOrder() : string
    + CalculateTotal(productsTotal : decimal) : decimal
    + CompleteDelivery(customerName : string, address : string) : string
    + GetDeliveryMethodName() : string
    + GetDeliveryPrice() : decimal
}

class StandardDeliveryOrder {
    + OrderType : string
    + ServicePrice : decimal
    + PrepareOrder() : string
}

class ExpressDeliveryOrder {
    + OrderType : string
    + ServicePrice : decimal
    + PrepareOrder() : string
}

class GiftDeliveryOrder {
    + OrderType : string
    + ServicePrice : decimal
    + PrepareOrder() : string
}

class StoreController {
    + Delivery() : IActionResult
    + Delivery(customerName, address, orderType, deliveryMethod) : IActionResult
    - CreateDeliveryMethod(deliveryMethod : string) : IDeliveryMethod
    - CreateDeliveryOrder(orderType : string, deliveryMethod : IDeliveryMethod) : DeliveryOrder
}

IDeliveryMethod <|.. CourierDeliveryMethod
IDeliveryMethod <|.. PickupDeliveryMethod
IDeliveryMethod <|.. LockerDeliveryMethod

DeliveryOrder o-- IDeliveryMethod : uses

DeliveryOrder <|-- StandardDeliveryOrder
DeliveryOrder <|-- ExpressDeliveryOrder
DeliveryOrder <|-- GiftDeliveryOrder

StoreController ..> DeliveryOrder : creates
StoreController ..> IDeliveryMethod : creates

@enduml