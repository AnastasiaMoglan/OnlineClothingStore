@startuml
skinparam classAttributeIconSize 0
left to right direction

interface IImplementation {
  +OperationImplementation(): string
}

class ConcreteImplementationA {
  +OperationImplementation(): string
}

class ConcreteImplementationB {
  +OperationImplementation(): string
}

abstract class Abstraction {
  #_implementation: IImplementation
  +Abstraction(implementation: IImplementation)
  +Operation(): string
}

class RefinedAbstractionA {
  +Operation(): string
}

class RefinedAbstractionB {
  +Operation(): string
}
class Client {
  +Run(abstraction: Abstraction): void
}

IImplementation <|.. ConcreteImplementationA
IImplementation <|.. ConcreteImplementationB

Abstraction <|-- RefinedAbstractionA
Abstraction <|-- RefinedAbstractionB

Abstraction --> IImplementation
Client --> Abstraction
@enduml